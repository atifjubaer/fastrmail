# ==============================================================================
# FastrMail Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your deployment.

# ─── Server Identity ──────────────────────────────────────────────────────────
FASTRMAIL_HOSTNAME=mail.example.com
FASTRMAIL_PRIMARY_DOMAIN=example.com

# ─── Admin Credentials ────────────────────────────────────────────────────────
FASTRMAIL_ADMIN_USER=admin
FASTRMAIL_ADMIN_PASS=changeme

# ─── Port Mapping (Host → Container) ─────────────────────────────────────────
SMTP_PORT=25
IMAP_PORT=143
HTTP_PORT=8080

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: trace, debug, info, warn, error
RUST_LOG=info

# ─── Storage ──────────────────────────────────────────────────────────────────
# Path on host for SQLite database, DKIM keys, Tantivy indexes, and attachments.
DATA_PATH=fastrmail_data

# ─── Docker Image ─────────────────────────────────────────────────────────────
DOCKER_IMAGE=fastrmail:latest
CONTAINER_NAME=fastrmail
