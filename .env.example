# ==============================================================================
# FastrMail Environment Configuration
# ==============================================================================

# ─── Server Identity ──────────────────────────────────────────────────────────
FASTRMAIL_HOSTNAME=mail.example.com
FASTRMAIL_PRIMARY_DOMAIN=example.com

# ─── Admin Credentials ────────────────────────────────────────────────────────
FASTRMAIL_ADMIN_USER=admin
FASTRMAIL_ADMIN_PASS=changeme

# ─── Port Mapping (Host → Container) ─────────────────────────────────────────
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
IMAP_PORT=143
POP3_PORT=110
HTTP_PORT=8080

# ─── Internal Bind Addresses ─────────────────────────────────────────────────
FASTRMAIL_BIND_SMTP=0.0.0.0:2525
FASTRMAIL_BIND_SUBMISSION=0.0.0.0:2526
FASTRMAIL_BIND_IMAP=0.0.0.0:1143
FASTRMAIL_BIND_POP3=0.0.0.0:1110
FASTRMAIL_BIND_HTTP=0.0.0.0:8080

# ─── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info

# ─── Storage ──────────────────────────────────────────────────────────────────
DATA_PATH=fastrmail_data

# ─── Docker Image ─────────────────────────────────────────────────────────────
DOCKER_IMAGE=fastrmail:latest
CONTAINER_NAME=fastrmail
