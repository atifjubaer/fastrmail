# ==============================================================================
# FastrMail Environment Configuration
# ==============================================================================

# External Port Mappings on Host
SMTP_PORT=25
IMAP_PORT=143
HTTP_PORT=8080

# Logging Level (trace, debug, info, warn, error)
RUST_LOG=info

# Persistent Data Storage Path on Host
DATA_PATH=./fastrmail_data

# Primary Domain (for DKIM key generation and outgoing HELO identification)
PRIMARY_DOMAIN=example.com
